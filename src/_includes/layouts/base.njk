<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description or site.description }}">
    <title>{{ title }} · Pegasus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Press+Start+2P&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/assets/styles/site.css' | url }}">
    <script type="module" src="{{ '/assets/scripts/pixel-cursor.js' | url }}" defer></script>
    <script type="module" src="{{ '/assets/scripts/theme-actions.js' | url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell{% if theme %} site-shell--{{ theme }}{% endif %}">{% include "components/header.njk" %}<main id="main-content">{{ content | safe }}</main>{% include "components/footer.njk" %}</div>
  </body>
</html>
