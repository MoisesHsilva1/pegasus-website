---
layout: layouts/base.njk
---
<article class="reading-page">
  <div class="reading-page__chrome"><span class="window-bar__dots" aria-hidden="true"><i></i><i></i></span><span>pegasus / theme</span></div>
  <div class="reading-page__content"><header class="reading-page__header"><p class="eyebrow">Theme</p><h1>{{ title }}</h1>{% if summary %}<p class="lede">{{ summary }}</p>{% endif %}</header>
  {% if image %}<figure class="theme-preview"><img src="{{ image }}" alt="{{ imageAlt }}"><figcaption>{{ imageCaption }}</figcaption></figure>{% endif %}
  <div class="reading-page__body prose">{{ content | safe }}</div></div>
</article>
