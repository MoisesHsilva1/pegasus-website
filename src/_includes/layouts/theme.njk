---
layout: layouts/base.njk
---
<article class="reading-page">
  <div class="reading-page__content"><header class="reading-page__header"><p class="eyebrow">Theme / {{ accent }}</p><h1>{{ title }}</h1>{% if summary %}<p class="lede">{{ summary }}</p>{% endif %}<div class="theme-detail__actions"><a class="button" href="{{ repoUrl }}">Official repository ↗</a></div></header>
  {% if image %}<figure class="theme-preview"><img src="{{ image | url }}" alt="{{ imageAlt }}"><figcaption>{{ imageCaption }}</figcaption><a class="theme-detail__utility" href="{{ image | url }}" download>Download wallpaper ↓</a></figure>{% endif %}
  <section class="theme-detail__palette" aria-labelledby="palette-title"><div><p class="eyebrow">Palette</p><h2 id="palette-title">Seven colors, one system.</h2></div><div class="theme-palette theme-palette--large">{% for color in palette %}<span class="theme-palette__swatch" style="--swatch: {{ color }}"><span>{{ color }}</span></span>{% endfor %}</div><button class="theme-detail__utility theme-detail__utility--palette" type="button" data-copy-palette="{{ palette | join(', ') }}">Copy palette</button></section><div class="theme-detail__meta"><span><strong>VS Code</strong>{{ vscodeTheme }}</span><span><strong>Extension</strong>{{ vscodeExtension }}</span><span><strong>Surfaces</strong>{{ surfaces | join(", ") }}</span></div>
  </div>
</article>
