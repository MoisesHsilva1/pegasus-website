---
layout: layouts/base.njk
---
<article class="reading-page">
  <div class="reading-page__content"><header class="reading-page__header"><p class="eyebrow">{{ copy.themeChrome }} / {{ accent }}</p><h1>{{ title }}</h1>{% if summary %}<p class="lede">{{ summary }}</p>{% endif %}<div class="theme-detail__actions"><a class="button" href="{{ repoUrl }}">{{ copy.officialRepository }}</a></div></header>
  {% if image %}<figure class="theme-preview"><img src="{{ image | url }}" alt="{{ imageAlt }}"><figcaption>{{ imageCaption }}</figcaption><a class="theme-detail__utility" href="{{ image | url }}" download>{{ copy.downloadWallpaper }}</a></figure>{% endif %}
  <section class="theme-detail__palette" aria-labelledby="palette-title"><div><p class="eyebrow">{{ copy.themes }}</p><h2 id="palette-title">{{ copy.sevenColors }}</h2></div><div class="theme-palette theme-palette--large">{% for color in palette %}<span class="theme-palette__swatch" style="--swatch: {{ color }}"><span>{{ color }}</span></span>{% endfor %}</div><button class="theme-detail__utility theme-detail__utility--palette" type="button" data-copy-palette="{{ palette | join(', ') }}">{{ copy.copyPalette }}</button></section><div class="theme-detail__meta"><span><strong>{{ copy.vscode }}</strong>{{ vscodeTheme }}</span><span><strong>{{ copy.extension }}</strong>{{ vscodeExtension }}</span><span><strong>{{ copy.surfaces }}</strong>{{ surfaces | join(", ") }}</span></div>
  </div>
</article>
